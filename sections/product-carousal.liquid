{% schema %}
  {
    "name": "Product Carousel",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Featured sale"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#fcfdfa"
      },
      {
        "type": "text",
        "id": "btn_show_all_text",
        "label": "Show All Button Text",
        "default": "Show all products"
      },
      {
        "type": "url",
        "id": "btn_show_all_link",
        "label": "Show All Link"
      }, {
        "type": "header",
        "content": "Collection Selection"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Select Collection to Display"
      }
    ],
    "presets": [
      {
        "name": "Product Carousel"
      }
    ]
  }
{% endschema %}

<div class="product-carousel-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="section-title" style="color: #e27b58;">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="product-grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: 3 %}
          {% render 'product-card'
            , product: product
            , rating: 4
            , button_text: 'Buy now →' %}
        {% endfor %}
      {% else %}
        <!-- Fallback if no collection selected -->
        {% for i in (1..3) %}
          <div class="product-card">
            <div class="product-card-inner">
              <div class="product-image-wrapper placeholder-image">{{ 'product-1' | placeholder_svg_tag }}</div>
              <div class="product-info">
                <h3 class="product-title">Sample Product {{ i }}</h3>
                <div class="product-meta">
                  <span class="product-price">$19.99</span>
                </div>
                <button class="btn-buy-now">Buy now →</button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.btn_show_all_text != blank %}
      <div class="view-all-wrapper">
        <a href="{{ section.settings.btn_show_all_link }}" class="btn-view-all">{{ section.settings.btn_show_all_text }}</a>
      </div>
    {% endif %}

  </div>
</div>

<style>

  .page-width{
  max-width: 1400px;
    margin: 0 auto;
  }
  .product-carousel-section {
    padding: 60px 0;
  }
  .section-title {
    text-align: center;
    font-family: "Georgia"
    , serif;
    font-weight: normal;
    font-size: 2rem;
    margin-bottom: 40px;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 40px;
  }

  /* Product Card Styling */
  .product-card {
    background: #eef3ec;
    /* Light green card bg */
    border-radius: 12px;
    padding: 20px;
    transition: transform 0.3s ease;
  }
  .product-card:hover {
    transform: translateY(-5px);
  }
  .product-card-inner {
    text-align: center;
  }
  .product-image-wrapper {
    height: 180px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
  }
  .product-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .placeholder-image svg {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }
  .product-title {
    font-size: 1.1rem;
    color: #3b5a44;
    font-weight: 500;
    margin-bottom: 10px;
    font-family: sans-serif;
  }
  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }
  .product-rating .star {
    color: #f4c542;
    font-size: 14px;
  }
  .product-rating .star.empty {
    color: #ccc;
  }
  .product-price {
    font-weight: bold;
    color: #333;
    font-size: 1.1rem;
  }
  .btn-buy-now {
    background: #3b5a44;
    color: #fff;
    border: none;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: opacity 0.3s;
    width: 100%;
  }
  .btn-buy-now:hover {
    opacity: 0.8;
  }

  .view-all-wrapper {
    text-align: center;
    margin-top: 20px;
  }
  .btn-view-all {
    background: #5a7c64;
    color: #fff;
    padding: 10px 25px;
    border-radius: 20px;
    text-decoration: none;
    font-size: 0.9rem;
    display: inline-block;
  }
  .btn-view-all:hover {
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 550px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>