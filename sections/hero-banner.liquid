{% schema %}
  {
    "name": "Hero Banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "From Garden To Cup<br>Good Tea, Good Life."
      },
      {
        "type": "text",
        "id": "button_1_text",
        "label": "Button 1 Text",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "button_1_link",
        "label": "Button 1 Link"
      }, {
        "type": "text",
        "id": "button_2_text",
        "label": "Button 2 Text",
        "default": "Explore"
      }, {
        "type": "url",
        "id": "button_2_link",
        "label": "Button 2 Link"
      }
    ],
    "presets": [
      {
        "name": "Hero Banner"
      }
    ]
  }
{% endschema %}

<div class="hero-section" style="background-image: url('{{ section.settings.background_image | img_url: 'master' }}');">
  <div class="hero-overlay">
    <div class="page-width">
      <div class="hero-content">
        <h1 class="hero-title">{{ section.settings.title }}</h1>
        <div class="hero-buttons">
          <a href="{{ section.settings.button_1_link }}" class="btn btn-white">{{ section.settings.button_1_text }}</a>
          <a href="{{ section.settings.button_2_link }}" class="btn btn-outline">{{ section.settings.button_2_text }}</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-section {
    background-size: cover;
    background-position: center;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    height: 900px;
  }
  .hero-content {
    color: #fff;
    z-index: 2;
    position: relative;
  }
  @media screen(min-width: 1200px) {
    .hero-content {
      width: 45%;
    }
  }
  .hero-title {
    font-size: 3.5rem;
    line-height: 1.2;
    margin-bottom: 20px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    font-family: "Georgia"
    , serif;
  }
  .hero-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    padding: 12px 30px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    font-size: 1.1rem;
  }
  .btn-white {
    background-color: #fff;
    color: #3b5a44;
  }
  .btn-white:hover {
    opacity: 0.9;
  }
  .btn-outline {
    background-color: transparent;
    border: 2px solid #fff;
    color: #fff;
  }
  .btn-outline:hover {
    background-color: #fff;
    color: #3b5a44;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-section {
      min-height: 400px;
    }
  }
</style>