{% schema %}
  {
    "name": "About Us (Dark)",
    "settings": [
      {
        "type": "header",
        "content": "Text Settings"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "About us"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Herbora: Rooted in nature, Crafted for you!"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Herbora, we bring you the pure essence of nature in every sip. Sourced from organic forms and crafted with care, Our teas offers a harmonious blend of flavour and wellness. Experience the goodness of tradition, One cup at a time."
      }, {
        "type": "header",
        "content": "Style Settings"
      }, {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#2d4735"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Accent Color (Subheading)",
        "default": "#e27b58"
      }, {
        "type": "header",
        "content": "Image Settings"
      }, {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      }, {
        "type": "select",
        "id": "image_position",
        "label": "Image Position (Desktop)",
        "options": [
          {
            "value": "right",
            "label": "Right"
          }, {
            "value": "left",
            "label": "Left"
          }
        ],
        "default": "right"
      }
    ],
    "presets": [
      {
        "name": "About Us (Dark)"
      }
    ]
  }
{% endschema %}

<div class="about-dark-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="page-width">
    <div class="about-dark-wrapper {% if section.settings.image_position == 'left' %}image-left{% else %}image-right{% endif %}">

      <!-- Text Column -->
      <div class="about-text-col">
        {% if section.settings.subheading != blank %}
          <h4 class="about-subheading" style="color: {{ section.settings.accent_color }};">{{ section.settings.subheading }}</h4>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2 class="about-heading">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="about-description rte">
            {{ section.settings.description | newline_to_br }}
          </div>
        {% endif %}
      </div>

      <!-- Image Column -->
      <div class="about-image-col">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            loading="lazy"
            alt="{{ section.settings.image.alt | default: section.settings.title }}"
            class="about-img"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}">
        {% else %}
          <!-- Fallback placeholder if no image is selected -->
          <div class="about-img-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>

<style>
  .about-dark-section {
    padding: 60px 20px;
    width: 100%;
  }

  .about-dark-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Text Column Styling */
  .about-text-col {
    flex: 1;
    min-width: 300px;
  }

  .about-subheading {
    font-family: sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0 0 10px;
    letter-spacing: 0.5px;
  }

  .about-heading {
    font-family: "Georgia"
    , serif;
    /* Matches the serif font from the image */
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 20px;
  }

  .about-description {
    font-family: sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  /* Image Column Styling */
  .about-image-col {
    flex: 1;
    min-width: 300px;
    display: flex;
    justify-content: flex-end;
  }

  .about-img {
    width: 100%;
    height: 350px;
    /* Fixed height for consistency */
    object-fit: cover;
    border-radius: 20px;
    /* Rounded corners as per image */
    display: block;
  }

  .about-img-placeholder {
    width: 100%;
    height: 350px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .about-img-placeholder svg {
    width: 100px;
    height: 100px;
    fill: rgba(255, 255, 255, 0.2);
  }

  /* Responsive Styles */
  @media (max-width: 900px) {
    .about-dark-wrapper {
      flex-direction: column;
      gap: 30px;
    }

    /* Mobile support for choosing 'left' or 'right' in settings */
    .about-dark-wrapper.image-left {
      flex-direction: column-reverse;
    }
    .about-dark-wrapper.image-right {
      flex-direction: column;
    }

    .about-image-col {
      width: 100%;
      justify-content: center;
    }

    .about-img {
      height: 250px;
    }

    .about-heading {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 550px) {
    .about-dark-section {
      padding: 40px 15px;
    }
    .about-img {
      height: 200px;
    }
    .about-heading {
      font-size: 1.5rem;
    }
  }
</style>