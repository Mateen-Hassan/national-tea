{% schema %}
  {
    "name": "Centered Text Block",
    "settings": [
      {
        "type": "header",
        "content": "Text Content"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Why choose us?"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Savor The Goodness of Organic Bliss"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Crafted with care, Steeped in nature,\nEnjoy of goodness of every cup."
      }, {
        "type": "header",
        "content": "Style Settings"
      }, {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#f0f9ef"
      }, {
        "type": "color",
        "id": "subheading_color",
        "label": "Subheading Color",
        "default": "#c85a42"
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "Heading Color",
        "default": "#2d4735"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Description Color",
        "default": "#33443a"
      }, {
        "type": "header",
        "content": "Spacing"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 20,
        "max": 100,
        "step": 5,
        "unit": "px",
        "label": "Top Padding",
        "default": 60
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 20,
        "max": 100,
        "step": 5,
        "unit": "px",
        "label": "Bottom Padding",
        "default": 60
      }, {
        "type": "range",
        "id": "max_width",
        "min": 400,
        "max": 900,
        "step": 20,
        "unit": "px",
        "label": "Max Content Width",
        "default": 720
      }
    ],
    "presets": [
      {
        "name": "Centered Text Block"
      }
    ]
  }
{% endschema %}

<div class="text-block-center-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="text-block-inner" style="max-width: {{ section.settings.max_width }}px;">

      {% if section.settings.subheading != blank %}
        <h4 class="text-subheading" style="color: {{ section.settings.subheading_color }};">
          {{ section.settings.subheading }}
        </h4>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="text-heading" style="color: {{ section.settings.heading_color }};">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="text-description rte" style="color: {{ section.settings.text_color }};">
          {{ section.settings.description | newline_to_br }}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  .text-block-center-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
  }

  .text-block-inner {
    margin: 0 auto;
    text-align: center;
  }

  .text-subheading {
    font-family: sans-serif;
    font-weight: 500;
    font-size: 1.1rem;
    margin: 0 0 10px;
    letter-spacing: 0.5px;
  }

  .text-heading {
    font-family: "Georgia"
    , serif;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 16px;
  }

  .text-description {
    font-family: sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .text-heading {
      font-size: 1.8rem;
    }
    .text-description {
      font-size: 1rem;
    }
  }

  @media (max-width: 550px) {
    .text-heading {
      font-size: 1.5rem;
    }
    .text-description {
      font-size: 0.95rem;
    }
  }
</style>