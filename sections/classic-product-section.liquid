<!-- ============================================ -->
<!-- SECTION: Classic Single Product + AJAX Cart   -->
<!-- ============================================ -->

{% schema %}
{
  "name": "Classic Single Product",
  "settings": [
    {
      "type": "header",
      "content": "Product Selection"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select your product"
    },
    {
      "type": "header",
      "content": "Style & Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#2d4735"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price Color",
      "default": "#2d4735"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Add to Cart Button Color",
      "default": "#2d4735"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor/Brand",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show Quantity Selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable Image Zoom on Hover",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Classic Single Product"
    }
  ]
}
{% endschema %}

{% assign product = section.settings.product %}

<div class="classic-product-wrapper" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="classic-product-grid">

      <!-- LEFT COLUMN: Images -->
      <div class="product-images-col">
        <div class="product-main-image">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | default: product.title }}"
              loading="lazy"
              class="main-img {% if section.settings.enable_image_zoom %}image-zoom{% endif %}"
              id="main-product-image">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'main-img placeholder-img' }}
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="product-thumbnails">
            {% for image in product.images %}
              <div class="thumb-wrapper" data-image="{{ image | image_url: width: 800 }}">
                <img
                  src="{{ image | image_url: width: 150 }}"
                  alt="{{ image.alt }}"
                  class="thumb-img">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT COLUMN: Details + AJAX Cart -->
      <div class="product-info-col">

        {% if section.settings.show_vendor and product.vendor != blank %}
          <p class="product-vendor">{{ product.vendor }}</p>
        {% endif %}

        <h1 class="product-classic-title" style="color: {{ section.settings.title_color }};">
          {{ product.title }}
        </h1>

        <!-- DYNAMIC PRICE DISPLAY -->
        <div class="product-classic-price" style="color: {{ section.settings.price_color }};" id="product-price-display">
          <span class="price-regular" id="price-regular">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="price-sale" id="price-sale">{{ product.compare_at_price | money }}</span>
          {% endif %}
        </div>

        <div class="product-classic-description rte">
          {{ product.description }}
        </div>

        <!-- ===== AJAX FORM ===== -->
        {% form 'product', product, class: 'classic-product-form', id: 'ajax-product-form' %}

          <!-- VARIANT SELECTOR (enhanced) -->
          <div class="classic-variants">
            {% for option in product.options_with_values %}
              <div class="variant-wrapper">
                <label class="variant-label" for="Option-{{ option.name | handle }}">{{ option.name }}:</label>
                <select
                  id="Option-{{ option.name | handle }}"
                  class="variant-select"
                  name="options[{{ option.name }}]"
                  data-option-name="{{ option.name }}"
                  data-product-handle="{{ product.handle }}">
                  {% for value in option.values %}
                    <option
                      value="{{ value }}"
                      {% if option.selected_value == value %}
                        selected
                      {% endif %}>
                      {{ value }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endfor %}
          </div>

          <!-- hidden input for variant ID -->
          <input type="hidden" name="id" id="variant-id-input" value="{{ product.selected_or_first_available_variant.id }}">

          <div class="classic-actions">
            {% if section.settings.show_quantity %}
              <div class="quantity-wrapper">
                <label for="Quantity">Quantity:</label>
                <div class="quantity-selector">
                  <button
                    type="button"
                    class="qty-btn minus"
                    onclick="this.parentNode.querySelector('input[type=number]').stepDown()">−</button>
                  <input
                    type="number"
                    id="Quantity"
                    name="quantity"
                    value="1"
                    min="1">
                  <button
                    type="button"
                    class="qty-btn plus"
                    onclick="this.parentNode.querySelector('input[type=number]').stepUp()">+</button>
                </div>
              </div>
            {% endif %}

            <!-- ADD TO CART (AJAX) -->
            <button
              type="submit"
              name="add"
              class="btn-add-to-cart"
              style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};"
              id="add-to-cart-btn">
              <span>Add to Cart</span>
            </button>

            <!-- BUY NOW (AJAX + redirect to checkout) -->
            <button
              type="button"
              class="btn-buy-now"
              style="background-color: #2d4735; color: #ffffff; border: none; padding: 15px 30px; border-radius: 8px; font-size: 1.1rem; font-weight: bold; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0,0,0,0.05); flex:1; min-width:160px;"
              id="buy-now-btn">
              <span>Buy It Now</span>
            </button>

          </div>
        {% endform %}

        <!-- AJAX feedback area -->
        <div id="cart-message" style="margin-top: 20px; font-weight:500; min-height:30px;"></div>

      </div>
    </div>
  </div>
</div>

<style>
  .classic-product-wrapper {
    padding: 60px 20px;
    width: 100%;
  }
  .classic-product-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 50px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Left Column - Images */
  .product-images-col {
    flex: 1;
    min-width: 320px;
  }
  .product-main-image {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #fafafa;
    margin-bottom: 15px;
    position: relative;
  }
  .main-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }
  .image-zoom:hover {
    transform: scale(1.05);
  }
  .placeholder-img {
    width: 100%;
    height: 400px;
    fill: #e0e0e0;
  }

  .product-thumbnails {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .thumb-wrapper {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border 0.2s;
  }
  .thumb-wrapper:hover {
    border-color: #ccc;
  }
  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right Column - Info */
  .product-info-col {
    flex: 1;
    min-width: 320px;
    display: flex;
    flex-direction: column;
  }
  .product-vendor {
    font-family: sans-serif;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #777;
    font-size: 0.85rem;
    margin-bottom: 8px;
  }
  .product-classic-title {
    font-family: "Georgia", serif;
    font-size: 2.5rem;
    margin: 0 0 15px;
    font-weight: 700;
    line-height: 1.2;
  }
  .product-classic-price {
    font-family: sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 25px;
  }
  .price-sale {
    color: #d9534f;
    text-decoration: line-through;
    margin-left: 15px;
    font-size: 1.1rem;
    opacity: 0.7;
  }
  .product-classic-description {
    font-family: sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #444;
    margin-bottom: 35px;
  }
  .product-classic-description p {
    margin: 0 0 12px;
  }

  /* Form & Actions */
  .classic-product-form {
    width: 100%;
  }

  .classic-variants {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 25px;
  }
  .variant-wrapper {
    display: flex;
    flex-direction: column;
  }
  .variant-label {
    font-family: sans-serif;
    font-weight: 600;
    color: #333;
    margin-bottom: 5px;
  }
  .variant-select {
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #fff;
    font-size: 1rem;
    width: 100%;
    max-width: 300px;
  }

  .classic-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    align-items: center;
  }

  .quantity-wrapper {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .quantity-wrapper label {
    font-family: sans-serif;
    font-weight: 600;
    color: #333;
    font-size: 0.9rem;
  }
  .quantity-selector {
    display: flex;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
  }
  .quantity-selector input {
    width: 60px;
    border: none;
    text-align: center;
    font-size: 1.1rem;
    padding: 10px 0;
    outline: none;
  }
  .qty-btn {
    background: #f5f5f5;
    border: none;
    padding: 0 15px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: background 0.2s;
    font-weight: bold;
    color: #555;
  }
  .qty-btn:hover {
    background: #e0e0e0;
  }

  .btn-add-to-cart {
    flex: 1;
    min-width: 160px;
    border: none;
    padding: 15px 30px;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }
  .btn-add-to-cart:hover {
    opacity: 0.85;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
  }

  .btn-buy-now {
    flex: 1;
    min-width: 160px;
  }
  .btn-buy-now:hover {
    opacity: 0.85;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
  }

  /* message */
  #cart-message {
    font-family: sans-serif;
    font-size: 0.95rem;
  }
  .msg-success {
    color: #2d4735;
  }
  .msg-error {
    color: #b33;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .classic-product-grid {
      flex-direction: column;
      gap: 30px;
    }
    .product-classic-title {
      font-size: 2rem;
    }
    .main-img {
      height: auto;
    }
    .classic-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .quantity-wrapper {
      flex-direction: row;
      align-items: center;
      gap: 10px;
    }
    .btn-add-to-cart, .btn-buy-now {
      width: 100%;
    }
  }
</style>

<!-- ================================================== -->
<!-- AJAX CART JAVASCRIPT (Add to Cart + Buy Now)       -->
<!-- ================================================== -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('ajax-product-form');
    const addToCartBtn = document.getElementById('add-to-cart-btn');
    const buyNowBtn = document.getElementById('buy-now-btn');
    const messageEl = document.getElementById('cart-message');
    const variantIdInput = document.getElementById('variant-id-input');
    const priceRegular = document.getElementById('price-regular');
    const priceSale = document.getElementById('price-sale');
    const mainImage = document.getElementById('main-product-image');

    // Variant data from Shopify (all variants)
    const variants = {{ product.variants | json }};
    // Options mapping for quick lookup
    const optionNames = {{ product.options | json }};

    // ----- Helper: get selected variant ID -----
    function getSelectedVariantId() {
      // If no variant selectors, return default variant id
      const selects = document.querySelectorAll('.variant-select');
      if (selects.length === 0) {
        return variants.length > 0 ? variants[0].id : null;
      }

      // Build selected options object
      const selectedOptions = {};
      selects.forEach(sel => {
        const optionName = sel.getAttribute('data-option-name') || sel.id.replace('Option-', '').trim();
        selectedOptions[optionName] = sel.value;
      });

      // Find matching variant
      for (let i = 0; i < variants.length; i++) {
        const v = variants[i];
        let match = true;
        // Compare each option
        for (let j = 0; j < optionNames.length; j++) {
          const optName = optionNames[j];
          const selectedVal = selectedOptions[optName];
          if (selectedVal && v.options[j] !== selectedVal) {
            match = false;
            break;
          }
        }
        if (match) return v.id;
      }
      // fallback: first variant
      return variants.length > 0 ? variants[0].id : null;
    }

    // ----- Helper: get variant data by ID -----
    function getVariantById(id) {
      return variants.find(v => v.id === id) || null;
    }

    // ----- Update price and image when variant changes -----
    function updateVariantDisplay(variantId) {
      const variant = getVariantById(variantId);
      if (!variant) return;

      // Update price
      if (priceRegular) {
        priceRegular.textContent = variant.price | money;
      }
      if (priceSale) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          priceSale.textContent = variant.compare_at_price | money;
          priceSale.style.display = 'inline';
        } else {
          priceSale.style.display = 'none';
        }
      }

      // Update main image if variant has a featured image
      if (variant.featured_image && mainImage) {
        const imgUrl = variant.featured_image.src;
        mainImage.src = imgUrl;
      }
    }

    // ----- Update variant ID and display on change -----
    function updateVariant() {
      const id = getSelectedVariantId();
      if (id) {
        variantIdInput.value = id;
        updateVariantDisplay(id);
      }
    }

    // Attach change listeners to all variant selects
    document.querySelectorAll('.variant-select').forEach(sel => {
      sel.addEventListener('change', updateVariant);
    });

    // ----- Show message -----
    function showMessage(text, isError = false) {
      messageEl.textContent = text;
      messageEl.className = isError ? 'msg-error' : 'msg-success';
      if (!isError) {
        setTimeout(() => {
          if (messageEl.textContent === text) {
            messageEl.textContent = '';
            messageEl.className = '';
          }
        }, 5000);
      }
    }

    // ----- AJAX add to cart -----
    function ajaxAddToCart(variantId, quantity, callback) {
      const url = '/cart/add.js';
      const data = {
        id: variantId,
        quantity: quantity
      };

      fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(data)
      })
      .then(response => {
        if (!response.ok) {
          return response.json().then(err => { throw new Error(err.description || 'Error adding to cart'); });
        }
        return response.json();
      })
      .then(cartItem => {
        // Update cart count
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            const count = cart.item_count || 0;
            const cartEl = document.querySelector('.site-header__cart-count, .cart-count, [data-cart-count]');
            if (cartEl) cartEl.textContent = count;
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
          })
          .catch(e => console.warn('Cart count update skipped:', e));
        if (callback) callback(null, cartItem);
      })
      .catch(err => {
        if (callback) callback(err.message, null);
        else showMessage('Error: ' + err.message, true);
      });
    }

    // ----- Get quantity -----
    function getQuantity() {
      const qtyInput = document.getElementById('Quantity');
      if (qtyInput) return parseInt(qtyInput.value) || 1;
      return 1;
    }

    // ----- Form submit: Add to Cart (AJAX) -----
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const variantId = getSelectedVariantId();
      const quantity = getQuantity();
      if (!variantId) {
        showMessage('Please select a valid variant.', true);
        return;
      }

      addToCartBtn.disabled = true;
      addToCartBtn.style.opacity = '0.6';
      const originalText = addToCartBtn.querySelector('span')?.textContent || 'Add to Cart';
      if (addToCartBtn.querySelector('span')) addToCartBtn.querySelector('span').textContent = 'Adding...';

      ajaxAddToCart(variantId, quantity, function(err, item) {
        addToCartBtn.disabled = false;
        addToCartBtn.style.opacity = '1';
        if (addToCartBtn.querySelector('span')) addToCartBtn.querySelector('span').textContent = originalText;

        if (err) {
          showMessage('❌ ' + err, true);
        } else {
          showMessage('✅ Added to cart!');
        }
      });
    });

    // ----- Buy Now (AJAX + redirect) -----
    buyNowBtn.addEventListener('click', function(e) {
      e.preventDefault();
      const variantId = getSelectedVariantId();
      const quantity = getQuantity();
      if (!variantId) {
        showMessage('Please select a valid variant.', true);
        return;
      }

      buyNowBtn.disabled = true;
      buyNowBtn.style.opacity = '0.6';
      const originalText = buyNowBtn.querySelector('span')?.textContent || 'Buy It Now';
      if (buyNowBtn.querySelector('span')) buyNowBtn.querySelector('span').textContent = 'Processing...';

      ajaxAddToCart(variantId, quantity, function(err, item) {
        buyNowBtn.disabled = false;
        buyNowBtn.style.opacity = '1';
        if (buyNowBtn.querySelector('span')) buyNowBtn.querySelector('span').textContent = originalText;

        if (err) {
          showMessage('❌ ' + err, true);
        } else {
          showMessage('✅ Redirecting to checkout...');
          window.location.href = '/checkout';
        }
      });
    });

    // ----- Thumbnail click: update main image -----
    document.querySelectorAll('.thumb-wrapper').forEach(thumb => {
      thumb.addEventListener('click', function() {
        const imgSrc = this.getAttribute('data-image') || this.querySelector('.thumb-img')?.getAttribute('src');
        if (imgSrc && mainImage) {
          // Use high-res version if available
          let newSrc = imgSrc.replace(/_150x/g, '_800x');
          if (newSrc === imgSrc) newSrc = imgSrc;
          mainImage.setAttribute('src', newSrc);
        }
      });
    });

    // ----- Initialize variant display on load -----
    updateVariant();

  });
</script>